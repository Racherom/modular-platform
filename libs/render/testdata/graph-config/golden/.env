# Settings docker compose reads for the stack graphconfig. setup.sh adds MP_UID and MP_GID: every
# module runs as that user, so it can read its secret files and write its data folders.
# Each module built on the module SDK has its own settings in config/<instance>.env.
# Never put a secret value here: secrets live in secrets/, created by setup.sh.
#
# Each setting below is commented out at its default. Remove the # and change it to set it, then
# run setup.sh again: it checks every value here before anything starts.

# The banner the teller shows.
# MP_TELLER__BANNER=$y $$z

# Domain the teller answers on.
# MP_TELLER__DOMAIN=example.org

# How much the teller logs.
# MP_TELLER__LEVEL=debug

# How strictly the teller checks clients.
# asked by setup.sh

# A message of the day, none when empty.
# MP_TELLER__MOTD=

# The teller's motto.
# MP_TELLER__MOTTO=$x

# A note shown on the teller's page.
# MP_TELLER__NOTE=a'b

# Origin clients reach the teller at.
# asked by setup.sh

# The teller's tagline.
# MP_TELLER__TAGLINE=a #b
