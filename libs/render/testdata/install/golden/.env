# Settings docker compose reads for the stack install. setup.sh adds MP_UID and MP_GID: every
# module runs as that user, so it can read its secret files and write its data folders.
# Never put a secret value here: secrets live in secrets/, created by setup.sh.
#
# Each setting below is commented out at its default. Remove the # and change it to set it, then
# run setup.sh again: it checks every value here before anything starts.

# The banner the vault shows above its page.
# MP_KEEPER__BANNER=costs $5 #1

# Domain the vault answers on.
# asked by setup.sh

# How much the vault logs.
# MP_KEEPER__LEVEL=info

# How strictly the vault checks clients.
# asked by setup.sh

# A message of the day, none when empty.
# MP_KEEPER__MOTD=

# A note shown on the vault's page.
# asked by setup.sh

# Origin clients reach the vault at.
# asked by setup.sh

# Port the vault listens on.
# asked by setup.sh

# How long a request may take.
# asked by setup.sh
