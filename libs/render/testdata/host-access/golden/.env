# Settings docker compose reads for the stack host-access. setup.sh adds MP_UID and MP_GID: every
# module runs as that user, so it can read its secret files and write its data folders.
# Never put a secret value here: secrets live in secrets/, created by setup.sh.
#
# Each setting below is commented out at its default. Remove the # and change it to set it, then
# run setup.sh again: it checks every value here before anything starts.

# Host folder the agent writes into.
# MP_AGENT__SPOOL=/var/spool/agent

# Host port for HTTP.
# MP_EDGE__HTTP_PORT=8080
