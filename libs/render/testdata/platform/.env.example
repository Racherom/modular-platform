# Settings docker compose reads for the stack modular-platform. setup.sh adds MP_UID and MP_GID: every
# module runs as that user, so it can read its secret files and write its data folders.
# Each module built on the module SDK has its own settings in config/<instance>.env.
# Never put a secret value here: secrets live in secrets/, created by setup.sh.
#
# Each setting below is commented out at its default. Remove the # and change it to set it, then
# run setup.sh again: it checks every value here before anything starts.

# Email of the admin (the first verified sign in with it becomes the admin).
# asked by setup.sh

# Contact email for the ACME account.
# MP_INGRESS__ACME_EMAIL=

# Path the platform is served under; unset at the site root.
# MP_INGRESS__BASE_PATH=

# The domain the platform answers on, with at least one dot (Authelia needs one).
# asked by setup.sh

# Host port for HTTP.
# MP_INGRESS__HTTP_PORT=80

# Host port for HTTPS.
# MP_INGRESS__HTTPS_PORT=443

# Scheme, host and port the browser sees.
# asked by setup.sh

# Where the public certificate comes from, Caddy's own authority or ACME (the domain must be public).
# MP_INGRESS__TLS_MODE=internal

# What a signed out visitor sees first.
# MP_WEB__SIGNED_OUT=index
