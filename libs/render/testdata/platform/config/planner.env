# Settings for planner (module planner). Edit and restart the module to apply.
# Lines starting with # are defaults or optional values; remove the # to set one.

# Where the planner runs, public behind the online tool or internal inside the platform.
MP_PLANNER_MODE=internal

# Requests per minute per client address in public mode.
# MP_PLANNER_RATE=60

# Proxies in front of the planner that append X-Forwarded-For.
# MP_PROXY_HOPS=1
