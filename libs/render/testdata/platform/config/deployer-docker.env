# Settings for deployer-docker (module deployer-docker). Edit and restart the module to apply.
# Lines starting with # are defaults or optional values; remove the # to set one.

# Absolute path of the deployments folder, the same path on the host and in the deployer.
# set to deployments in the folder setup.sh is in

# Group id that owns deployed files and secrets and runs deployed sdk modules.
# set to the id of the user setup.sh ran as (gid)

# User id that owns deployed files and secrets and runs deployed sdk modules.
# set to the id of the user setup.sh ran as (uid)

# Longest time an apply may spend pulling images.
# MP_PULL_TIMEOUT=10m

# Longest time an apply waits for every service to run and pass its healthcheck.
# MP_WAIT_TIMEOUT=5m
