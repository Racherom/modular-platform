# Settings for renderer (module renderer). Edit and restart the module to apply.
# Lines starting with # are defaults or optional values; remove the # to set one.

# Proxies in front of the renderer that append X-Forwarded-For.
# MP_PROXY_HOPS=1

# Where the renderer runs, public behind the online tool or internal inside the platform.
MP_RENDERER_MODE=internal

# Requests per minute per client address in public mode.
# MP_RENDERER_RATE=60
