# Settings for api (module api). Edit and restart the module to apply.
# Lines starting with # are defaults or optional values; remove the # to set one.

# Proxies in front of api that append X-Forwarded-For.
# MP_PROXY_HOPS=1

# A session ends after this long without a request.
# MP_SESSION_IDLE=1h

# A session ends this long after sign in, whatever its activity.
# MP_SESSION_MAX=12h
