# Settings docker compose reads for the stack pocket-id-managed. setup.sh adds MP_UID and MP_GID: every
# module runs as that user, so it can read its secret files and write its data folders.
# Never put a secret value here: secrets live in secrets/, created by setup.sh.
#
# Each setting below is commented out at its default. Remove the # and change it to set it, then
# run setup.sh again: it checks every value here before anything starts.

# Path the fixture is served under; unset at the site root.
# MP_EDGE__BASE_PATH=

# The domain the fixture answers on.
# MP_EDGE__DOMAIN=pocket.example.test

# Who may make an account without the admin; disabled means an invitation is needed.
# MP_POCKET_ID__SIGNUP=disabled
