{{/* Shell functions both setup.sh templates share: setup.sh.tmpl for every render, and
keeper-setup.sh.tmpl for the platform's keeper (spec 0016). Each one starts with a newline and
ends without one, so `{{template}}` on a line of its own inside an `{{- if}}` gives the same text
as the block it replaced. */}}
{{define "source-path"}}
# MP_SOURCE_PATH, a checkout of Modular Platform to build the platform images from instead of
# GitHub; resolved before the cd below, so a relative path starts where you ran setup.sh.
source_path=
if [ -n "${MP_SOURCE_PATH:-}" ]; then
	source_path=$(cd "$MP_SOURCE_PATH" 2>/dev/null && pwd -P) || {
		echo "setup.sh: MP_SOURCE_PATH=$MP_SOURCE_PATH is not a folder" >&2
		exit 1
	}
	if [ ! -f "$source_path/go.work" ]; then
		echo "setup.sh: MP_SOURCE_PATH=$source_path holds no go.work, so it is not a Modular Platform checkout" >&2
		exit 1
	fi
fi{{end}}
{{define "builds"}}
# The platform images this stack uses are not released yet, so no registry holds them: build
# each from Modular Platform at source_ref before anything else is made. A rerun builds again;
# the build cache makes that quick.
source_ref='{{.SourceRef}}'
{{- if .SourceLocal}}
if [ -z "$source_path" ]; then
	echo "setup.sh: this zip was made by a renderer built from a local checkout, so no commit on GitHub holds its code; set MP_SOURCE_PATH=<a checkout of Modular Platform> and run setup.sh again" >&2
	exit 1
fi
{{- end}}
build_images='{{range $i, $b := .Builds}}{{if $i}} {{end}}{{$b.Image}}{{end}}'
# build_stop TEXT stops setup.sh before it makes any file, naming the builds and how to build
# from a local checkout.
build_stop() {
	echo "setup.sh: $1" >&2
	echo "setup.sh: this stack builds $build_images from Modular Platform at $source_ref; MP_SOURCE_PATH=<a checkout of it> builds from that folder instead of GitHub" >&2
	exit 1
}
docker buildx version >/dev/null 2>&1 ||
	build_stop "the platform images build with BuildKit, and docker buildx is not available; install Docker 23 or newer with the buildx plugin"
docker_version=$(docker version --format '{{"{{"}}.Server.Version{{"}}"}}' 2>/dev/null) ||
	build_stop "Docker does not answer; start it and run setup.sh again"
[ "${docker_version%%.*}" -ge 23 ] 2>/dev/null ||
	build_stop "the platform images need Docker 23 or newer, this host runs $docker_version"
# build_image IMAGE MODULE builds IMAGE from build/MODULE/Dockerfile. A build from a local
# checkout is labeled local, never with source_ref, which the checkout may not match.
build_image() {
	if [ -n "$source_path" ]; then
		echo "building $1 from the local checkout $source_path"
		docker buildx build --load -t "$1" --build-arg MP_SOURCE=local --build-arg MP_SOURCE_REF=local \
			-f "build/$2/Dockerfile" "$source_path" ||
			build_stop "could not build $1 from the local checkout $source_path; the build needs Docker Hub (the Dockerfile frontend and base images)"
	else
		echo "building $1 from Modular Platform at $source_ref"
		docker buildx build --load -t "$1" --build-arg MP_SOURCE=git --build-arg MP_SOURCE_REF="$source_ref" \
			-f "build/$2/Dockerfile" "build/$2" ||
			build_stop "could not build $1 at $source_ref; the ref must be pushed, and the build needs GitHub and Docker Hub (the Dockerfile frontend and base images)"
	fi
}
{{- range .Builds}}
build_image {{shellQuote .Image}} {{shellQuote .Module}}
{{- end}}{{end}}
{{define "graph-set"}}
# env_or NAME TEXT prints the value of NAME in .env, or TEXT, the graph's value, when .env has no
# NAME line.
env_or() {
	if grep -q "^$1=" .env 2>/dev/null; then
		env_get "$1"
	else
		printf '%s\n' "$2"
	fi
}

# graph_set VAR TEXT says that the graph answers the asked value VAR with TEXT, or that a VAR line
# in .env with another value overrides it. It writes nothing: a later graph change reaches the
# stack on the next render.
graph_set() {
	if grep -q "^$1=" .env 2>/dev/null && [ "$(env_get "$1")" != "$2" ]; then
		printf '.env overrides the graph  %s\n' "$1"
		return 0
	fi
	printf 'set by the graph  %s=%s\n' "$1" "$2"
}{{end}}
{{define "nanoseconds"}}
# nanoseconds DURATION prints a duration like 1m30s in nanoseconds, or fails.
nanoseconds() {
	printf '%s\n' "$1" | LC_ALL=C awk '{
		s = $0; sign = 1
		if (s ~ /^[-+]/) { if (substr(s, 1, 1) == "-") sign = -1; s = substr(s, 2) }
		if (s == "0") { print 0; exit 0 }
		if (s == "") exit 1
		total = 0
		while (s != "") {
			if (!match(s, /^([0-9]+(\.[0-9]*)?|\.[0-9]+)/)) exit 1
			n = substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1)
			if (match(s, /^(ns|us|ms|h|m|s)/)) { u = substr(s, 1, RLENGTH) }
			else if (substr(s, 1, 3) == "\302\265s" || substr(s, 1, 3) == "\316\274s") { u = "us"; RLENGTH = 3 }
			else exit 1
			s = substr(s, RLENGTH + 1)
			total += n * (u == "ns" ? 1 : u == "us" ? 1e3 : u == "ms" ? 1e6 : u == "s" ? 1e9 : u == "m" ? 6e10 : 3.6e12)
		}
		printf "%.0f\n", sign * total
	}'
}{{end}}
{{define "valid"}}
# valid TYPE VALUE MIN MAX PATTERN [VALUES...] checks an answer by the value's type and rules,
# as the module itself does; a failure sets $why.
valid() {
	type=$1 value=$2 min=$3 max=$4 pattern=$5
	shift 5
	case $type in
	string)
		if [ -n "$pattern" ] && ! printf '%s\n' "$value" | LC_ALL=C grep -Eq -e "$(printf "$pattern")"; then
			why="does not match the pattern the module needs"
			return 1
		fi
		;;
	int)
		if ! printf '%s\n' "$value" | LC_ALL=C grep -Eq '^[-+]?[0-9]+$'; then
			why="is not a whole number"
			return 1
		fi
		value=${value#+}
		if [ -n "$min" ] && ! [ "$value" -ge "$min" ] 2>/dev/null; then
			why="is below the minimum $min"
			return 1
		fi
		if [ -n "$max" ] && ! [ "$value" -le "$max" ] 2>/dev/null; then
			why="is above the maximum $max"
			return 1
		fi
		;;
	bool)
		case $value in
		true | false) ;;
		*)
			why="is not true or false"
			return 1
			;;
		esac
		;;
{{- if .NeedDuration}}
	duration)
		if ! ns=$(nanoseconds "$value"); then
			why="is not a duration like 10s"
			return 1
		fi
		if [ -n "$min" ] && awk -v a="$ns" -v b="$min" 'BEGIN { exit !(a + 0 < b + 0) }'; then
			why="is below the minimum"
			return 1
		fi
		if [ -n "$max" ] && awk -v a="$ns" -v b="$max" 'BEGIN { exit !(a + 0 > b + 0) }'; then
			why="is above the maximum"
			return 1
		fi
		;;
{{- end}}
	url)
		if ! printf '%s\n' "$value" | LC_ALL=C grep -Eq '^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]+'; then
			why="is not an absolute URL with a scheme and a host"
			return 1
		fi
		;;
	enum)
		for allowed; do
			[ "$value" = "$allowed" ] && return 0
		done
		why="is not one of: $*"
		return 1
		;;
	esac
	return 0
}{{end}}
{{define "answers"}}
# A question is asked once: an answer already in .env, or a secret file that exists, is kept.
# With answers piped in, one per line, a wrong answer stops setup.sh; on a terminal it asks again.
retry_or_stop() {
	if [ ! -t 0 ]; then
		echo "setup.sh: $1: the answer $2" >&2
		exit 1
	fi
	echo "The answer $2; try again." >&2
}

# read_answer PROMPT SECRET reads one line into $answer, without echo for a secret.
read_answer() {
	printf '%s: ' "$1" >&2
	if [ "$2" = true ] && [ -t 0 ]; then
		stty -echo
		trap 'stty echo' EXIT
	fi
	answer=
	IFS= read -r answer || true
	if [ "$2" = true ] && [ -t 0 ]; then
		stty echo
		trap - EXIT
		echo >&2
	fi
}{{end}}
{{define "ask"}}
# ask VAR TYPE MIN MAX PATTERN OPTIONAL DESCRIPTION DEFAULT [VALUES...] asks a value and writes
# it into .env as VAR. An empty answer takes the default.
ask() {
	var=$1 type=$2 min=$3 max=$4 pattern=$5 optional=$6 description=$7 default=$8
	shift 8
	if grep -q "^$var=" .env 2>/dev/null; then
		echo "kept    $var in .env"
		return 0
	fi
	while :; do
		if [ -n "$default" ]; then
			read_answer "$description [$default]" false
		else
			read_answer "$description" false
		fi
		[ -n "$answer" ] || answer=$default
		if [ -z "$answer" ]; then
			[ "$optional" = true ] && break
			retry_or_stop "$var" "is required"
			continue
		fi
		case $answer in
{{- if .Keeper}}
		*[\'\"\`\\#]* | [[:space:]]* | *[[:space:]])
			retry_or_stop "$var" "holds a quote, \\ or #, or starts or ends with a space, which .env cannot keep"
{{- else}}
		*"'"* | *\\*)
			retry_or_stop "$var" "holds ' or \\, which .env cannot keep"
{{- end}}
			continue
			;;
		esac
		if valid "$type" "$answer" "$min" "$max" "$pattern" "$@"; then
			break
		fi
		retry_or_stop "$var" "$why"
	done
{{- if .Keeper}}
	# unquoted, with each $ written $$, which Compose reads back as one $
	printf '%s=%s\n' "$var" "$(printf '%s' "$answer" | sed 's/\$/$$/g')" >> .env
{{- else}}
	printf "%s='%s'\n" "$var" "$answer" >> .env
{{- end}}
	echo "added   $var to .env"
}{{end}}
