{
  "name": "@modular-platform/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "generate": "openapi-typescript ../contracts/openapi/renderer.yaml -o src/api/renderer.gen.ts && openapi-typescript ../contracts/openapi/api.yaml -o src/api/api.gen.ts",
    "a11y": "playwright test --config a11y/playwright.config.ts",
    "smoke:browser": "playwright test --config smoke/playwright.config.ts editor.spec.ts",
    "smoke:managed": "playwright test --config smoke/playwright.config.ts managed.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@xyflow/react": "12.12.1",
    "lucide-react": "1.60.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
