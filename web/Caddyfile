# The web module: serves the built editor on :8080 under MP_BASE_PATH (empty for the site root).
{
	auto_https off
	persist_config off
	# the admin endpoint stays on its default loopback address; the container healthcheck uses it
}

:8080 {
	root * /srv

	# the bundle loads only its own files and calls only its own origin
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# route keeps these rules in the order written
	route {
		# the web module only reads: a POST or any other method gets 404, never the app shell or a 405,
		# so a retired API route answers like an unknown one (spec 0027, AC-6)
		@write not method GET HEAD
		respond @write 404

		# <base> without the trailing slash redirects to <base>/
		@bare expression `{path} == "{$MP_BASE_PATH}" && "{$MP_BASE_PATH}" != ""`
		redir @bare {$MP_BASE_PATH}/ 308

		@outside not path {$MP_BASE_PATH}/*
		respond @outside 404

		uri strip_prefix "{$MP_BASE_PATH}"

		# hashed build files: cached for good; a missing one is a 404, never the app shell
		@assets path /assets/*
		handle @assets {
			@exists file
			header @exists Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# the theme script is not hashed, so the browser checks for a new one on every load
		@theme path /theme.js
		header @theme Cache-Control "no-cache"

		@file {
			file {path}
			not path /index.html */
		}
		handle @file {
			file_server
		}

		# every other path is a client side route: the app shell, templated with the placement
		handle {
			rewrite * /index.html
			header Cache-Control "no-cache"
			templates
			file_server
		}
	}
}
