{
  "modules": [
    {
      "apiVersion": "modular-platform/v1",
      "kind": "Module",
      "name": "postgres",
      "description": "PostgreSQL database server, official image, with one generated superuser password.",
      "image": "postgres:18.6",
      "provides": {
        "postgresql": {
          "capability": "postgresql",
          "version": "1.0",
          "port": 5432
        }
      }
    },
    {
      "apiVersion": "modular-platform/v1",
      "kind": "Module",
      "name": "whoami",
      "description": "Tiny HTTP service that echoes each request. Demo consumer, it declares an optional postgresql need to show wiring and ignores the values it receives.",
      "image": "traefik/whoami:v1.12.0",
      "provides": {
        "http": {
          "capability": "http",
          "version": "1.0",
          "port": 80
        }
      },
      "uses": {
        "postgresql": {
          "capability": "postgresql",
          "optional": true
        }
      }
    },
    {
      "apiVersion": "modular-platform/v1",
      "kind": "Module",
      "name": "test-app",
      "description": "Test entry: an app with a required postgresql need.",
      "image": "example.test/app:1",
      "provides": {
        "http": {
          "capability": "http",
          "version": "1.0",
          "port": 8080
        }
      },
      "uses": {
        "postgresql": {
          "capability": "postgresql"
        }
      }
    },
    {
      "apiVersion": "modular-platform/v1",
      "kind": "Module",
      "name": "test-hostile",
      "description": "<img src=x onerror=alert(1)> Test entry whose description holds HTML.",
      "image": "example.test/hostile:1",
      "provides": {
        "postgresql": {
          "capability": "postgresql",
          "version": "1.0",
          "port": 5432
        }
      }
    }
  ],
  "capabilities": []
}
