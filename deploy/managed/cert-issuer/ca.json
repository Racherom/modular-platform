{
  "root": "/run/secrets/cert_issuer_root",
  "crt": "/run/secrets/cert_issuer_intermediate",
  "key": "/run/secrets/cert_issuer_intermediate_key",
  "address": ":9000",
  "dnsNames": ["cert-issuer.modular-platform.internal"],
  "logger": {"format": "json"},
  "db": {"type": "badgerv2", "dataSource": "/home/step/db"},
  "authority": {
    "policy": {
      "x509": {
        "allow": {"dns": ["*.modular-platform.internal"]}
      }
    },
    "claims": {
      "minTLSCertDuration": "24h",
      "maxTLSCertDuration": "24h",
      "defaultTLSCertDuration": "24h"
    },
    "provisioners": [
      {"type": "ACME", "name": "acme", "challenges": ["tls-alpn-01"]}
    ]
  },
  "tls": {"minVersion": 1.3, "maxVersion": 1.3}
}
