# The managed platform's ingress: one origin for the editor, api and sign in (spec 0001). The
# prefix is kept on every route: api and Authelia both serve under <base>.
{
	email "{$PLATFORM_ACME_EMAIL}"
	servers {
		# only TCP 80 and 443 are published
		protocols h1 h2
	}
}

(tls-acme) {
	# a real certificate: browsers may keep to HTTPS for this host
	header Strict-Transport-Security "max-age=31536000"
}

(tls-internal) {
	tls internal
}

{$PLATFORM_DOMAIN} {
	import tls-{$PLATFORM_TLS}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	@api path {$MP_BASE_PATH}/api/*
	handle @api {
		# flush_interval -1: the event stream reaches the browser as it is written
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	@auth path {$MP_BASE_PATH}/auth {$MP_BASE_PATH}/auth/*
	handle @auth {
		reverse_proxy authelia:9091
	}

	@app path {$MP_BASE_PATH} {$MP_BASE_PATH}/*
	handle @app {
		# task dev:managed points this at the Vite dev server on the host
		reverse_proxy {$MP_WEB_UPSTREAM:web:8080}
	}

	handle {
		respond 404
	}
}
