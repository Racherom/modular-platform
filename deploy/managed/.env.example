# Every setting of the managed platform with its default. setup.sh writes .env from your answers;
# change a line there and run `docker compose up -d` again. Never put a secret here.

# Host name the platform answers on; must contain a dot (Authelia requires one).
PLATFORM_DOMAIN=platform.localhost
# Scheme, host and port the browser sees: https://<domain>, plus :<port> when not 443.
PLATFORM_ORIGIN=https://platform.localhost
# The first verified sign in with this email becomes the admin; later changes need `api admin reset`.
PLATFORM_ADMIN_EMAIL=admin@example.com
# internal: Caddy's own certificate authority; acme: a public certificate (needs a public domain).
PLATFORM_TLS=internal
# Optional email for the ACME account when PLATFORM_TLS is acme.
PLATFORM_ACME_EMAIL=
# Host ports the ingress publishes; no deployed stack may publish them.
PLATFORM_HTTP_PORT=80
PLATFORM_HTTPS_PORT=443
# Empty: the platform runs at the site root (the only placement in this version).
PLATFORM_BASE_PATH=
# Absolute path of this folder; deployments live in its deployments/ folder.
PLATFORM_DIR=/opt/modular-platform
# Your user and group ids: they own the secrets and run the platform's services.
PLATFORM_UID=1000
PLATFORM_GID=1000
# A session ends after this long without a request (5m to 24h) ...
PLATFORM_SESSION_IDLE=1h
# ... or this long after sign in (at most 720h, at least the idle time), whichever comes first.
PLATFORM_SESSION_MAX=12h
# Signed out: index shows the index with a Sign in button; sign-in goes straight to sign in.
PLATFORM_SIGNED_OUT=index
