# Settings of the online tool. Copy to .env (task online:env does it) and edit for your host.
# None of these is a secret.

# Your public host name; platform.localhost for local runs.
PLATFORM_DOMAIN=platform.localhost
# acme in production, internal locally (Caddy's own certificate authority).
PLATFORM_TLS=internal
# Optional contact address for the certificate authority.
PLATFORM_ACME_EMAIL=
PLATFORM_HTTPS_PORT=443
PLATFORM_HTTP_PORT=80
# Renderer requests per minute per client IP.
MP_RENDERER_RATE=60
# Empty: the online tool runs at the site root.
MP_BASE_PATH=
