# The online editor's ingress: one origin. <base>/renderer/* goes to the renderer with that prefix
# stripped (the renderer builds no URLs); everything else under <base>/ goes to the web module
# with the path unchanged.
{
	email "{$PLATFORM_ACME_EMAIL}"
	servers {
		# only TCP 80 and 443 are published
		protocols h1 h2
	}
}

(tls-acme) {
	# a real certificate: browsers may keep to HTTPS for this host
	header Strict-Transport-Security "max-age=31536000"
}

(tls-internal) {
	tls internal
}

{$PLATFORM_DOMAIN} {
	import tls-{$PLATFORM_TLS}

	# for every answer, the renderer's too; the web module adds its own content policy
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	@renderer path {$MP_BASE_PATH}/renderer/*
	handle @renderer {
		uri strip_prefix {$MP_BASE_PATH}/renderer
		reverse_proxy renderer:8080
	}

	@app path {$MP_BASE_PATH} {$MP_BASE_PATH}/*
	handle @app {
		# task dev points this at the Vite dev server on the host
		reverse_proxy {$MP_WEB_UPSTREAM:web:8080}
	}

	handle {
		respond 404
	}
}
