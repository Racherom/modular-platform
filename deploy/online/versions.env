# Exact image tags of the online editor graph; never latest.
CADDY_IMAGE=caddy:2.11.7-alpine
# The platform's own images (web, renderer); release-please bumps this line.
MP_VERSION=0.0.0 # x-release-please-version
# The git ref web and renderer build from while MP_VERSION is 0.0.0 (compose.prerelease.yaml,
# spec 0030): a full commit, a branch or a tag; `task online:up` resolves a branch or tag to its
# commit at each start.
MP_SOURCE_REF=main
